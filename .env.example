# Postgres. The app refuses editorial API calls when this is missing.
DATABASE_URL=postgres://ujer_app:ujer_app@127.0.0.1:5434/unilag_journal

# At least 32 characters. openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Set to true once mail delivery exists. Local sign-up works while this is unset.
REQUIRE_EMAIL_VERIFICATION=false

# ORCID generic OIDC. Both must be set or the provider is not registered.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Paystack. Amounts are in kobo, matching charges.amount_minor.
PAYSTACK_SECRET_KEY=

# Bearer token for POST /api/v1/jobs/tick
JOB_SECRET=

# Optional. Used as the resource URL inside Crossref XML.
PUBLIC_SITE_URL=http://localhost:3000
CROSSREF_USERNAME=
CROSSREF_PASSWORD=

# Used only by `npm run db:seed`. Not a production password.
SEED_EDITOR_PASSWORD=
SEED_AUTHOR_PASSWORD=
